    "https://schema.org/text": [
      {
        "@language": "sr-Latn",
        "@value": "Атина, 28. XI 1925.\nNa povratku iz Carigrada, razgledajući Atinu, sjeća\nVas se i pozdravlja srdačno\nIvo Andrić\n28. XI. 25."
