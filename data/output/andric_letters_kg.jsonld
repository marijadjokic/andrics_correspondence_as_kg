      }
    ],
    "https://schema.org/text": [
      {
        "@language": "sr-Latn",
        "@value": "Женева, 18. XI 1930.\nGeneve, 18 XI. 30 g.\n5, re des Alpes\nDraga gospođice,\notišao šam iz Zagreba pre nego što sam mislio, a\nVaš telefon se oglušio u poslednjoi minuti, pred sam\npolazak.\nZdravo sam i dobro. Sa najboljim željama i srdačnim pozdravima\nI. Andrić"
      }
    ]
  },
