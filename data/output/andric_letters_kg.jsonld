    "https://schema.org/pagination": [
      {
        "@value": "6"
      }
    ],
    "https://schema.org/recipient": [
      {
        "@id": "https://example.org/andric-letters/entity/per_zdenka_markovic"
      }
    ],
    "https://schema.org/sender": [
      {
        "@id": "https://example.org/andric-letters/entity/per_ivo_andric"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "sr-Latn",
        "@value": "Женева, 6. IV 1932.\nŽeneva, 6 aprila 1932 g.\n5, rue des Alpes\nDraga gospođice,\nneki dan sam primio Vaše pozdrave iz Zagreba.\nImate pravo kad se čudite što Vam tako odavno ne\npišem, ali niste u pravu kad mislite da sam Vas zaboravio. Molim Vas da mi ne uzmete za zlo moje dugo\nćutanje i da mi verujete kad Vam kažem, da se često, i\nuvek najlepše, sećam Vas, vaše kuće, i vremena koje\nsam u Zagrebu proveo.\nBilo mi je prijatno kad sam video da ste se upoznali sa g. Fr. Schützom koji je pravi pesnik i „božjičovek“. Ja za njega imam mnogo simpatija koje su,\nnadam se, uzajamne, iako se nikad ne dopisujemo i\ngodinama se nismo videli.\nJa sam dobro sa zdravljem i uvek zauzet raznim\nposlovima. Ipak sam stigao da preko Uskrsa odem do\nFrankfurta i Weimara, da vidim Goetheov zavičaj.\nNadam se da su svi Vaši zdravo i dobro, i molim\nVas da ih pozdravite.\nVas srdačno pozdravlja, sa najboljim željama\nVaš\nI. Andrić"
      }
    ]
  },
