        "@id": "https://example.org/andric-letters/entity/per_ivo_andric"
      }
    ],
    "https://schema.org/pagination": [
      {
        "@value": "3"
      }
    ],
    "https://schema.org/recipient": [
      {
        "@id": "https://example.org/andric-letters/entity/per_zdenka_markovic"
      }
    ],
    "https://schema.org/sender": [
      {
        "@id": "https://example.org/andric-letters/entity/per_ivo_andric"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "sr-Latn",
        "@value": "Београд, 20. X 1926.\nBeograd 20. X. 26.\nDraga gospođice,\nhvala Vam na pismu koje me je obradovalo, iako\nsan o kom mi pišete nije mnogo veseo. Ali, Bog će dati\npa će dobro biti. Ovih dana sam mnogo mislio o pok.\nmami, jer joj upravo sada podižemo spomenik. Moja\ntetka je zdravo i, koliko se može, dobro. Znam i vjerujem Vam da se ne osećate dobro u tom zagrebačkom\n„javnom“ životu. Svuda je zlo. Ali podnosilo se i gore,\npa valja snositi. Pozdravite sve Vaše. Javite se.\nSrdačno Vas pozdravlja\nIvo Andrić"
      }
    ]
  },
