      {
        "@id": "https://example.org/andric-letters/mention/letter_0010/74"
      }
    ],
    "https://schema.org/dateSent": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "1927-09-30"
      }
    ],
    "https://schema.org/locationCreated": [
      {
        "@id": "https://example.org/andric-letters/entity/loc_marseille"
      }
    ],
    "https://schema.org/mentions": [
      {
        "@id": "https://example.org/andric-letters/entity/loc_marseille"
      },
      {
        "@id": "https://example.org/andric-letters/entity/date_30_ix_1927"
      },
      {
        "@id": "https://example.org/andric-letters/entity/loc_st_jacques"
      },
      {
        "@id": "https://example.org/andric-letters/entity/loc_zagreb"
      },
      {
        "@id": "https://example.org/andric-letters/entity/loc_grenoble"
      },
      {
        "@id": "https://example.org/andric-letters/entity/per_ivo_andric"
      }
    ],
    "https://schema.org/pagination": [
      {
        "@value": "4"
      }
    ],
    "https://schema.org/recipient": [
      {
        "@id": "https://example.org/andric-letters/entity/per_zdenka_markovic"
      }
    ],
    "https://schema.org/sender": [
      {
        "@id": "https://example.org/andric-letters/entity/per_ivo_andric"
      }
    ],
    "https://schema.org/text": [
      {
        "@language": "sr-Latn",
        "@value": "Marseille 30. IX 1927.\n51, rue St. Jacques\nDraga gospođice,\nhvala Vam da ste me se sjetili i da ste me malko\ntrgnuli iz ovih snova u koje čovjeka uljulja tuđi svijet i\nduga samoća.\nSve sam mislio da Vam se javim ili da svratim do\nVas kad budem prolazio kroz Zagreb, ali ove godine ne\nbi ništa od moga odsustva. Bio sam nekoliko dana službenim poslom na putu i prošao Grenobl i njegovu okolinu koja je ljepša nego čovjek može da kaže. Ovde\nimam dosta posla; jedino što ima lijepo i prijatno na\novom gradu, to je da mogu da se kupam svaki dan u\nmoru. Upoznao sam prilično dobro Francuze i Francusku.\nPozdravite Vaše. Ne zaboravite me. Srdačno Vas\npozdravlja\nIvo Andrić"
      }
    ]
  },
