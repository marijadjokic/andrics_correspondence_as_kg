        <https://example.org/andric-letters/mention/letter_0006/41>,
        <https://example.org/andric-letters/mention/letter_0006/42> ;
    schema:dateSent "1926-07-13"^^xsd:date ;
    schema:locationCreated <https://example.org/andric-letters/entity/loc_visegrad> ;
    schema:mentions <https://example.org/andric-letters/entity/date_13_vii_1926>,
        <https://example.org/andric-letters/entity/date_13_vii_26>,
        <https://example.org/andric-letters/entity/loc_austrija>,
        <https://example.org/andric-letters/entity/loc_eisenkappel>,
        <https://example.org/andric-letters/entity/loc_villach>,
        <https://example.org/andric-letters/entity/loc_visegrad>,
        <https://example.org/andric-letters/entity/per_ivo_andric>,
        <https://example.org/andric-letters/entity/per_zdenka_markovic> ;
    schema:pagination "2" ;
    schema:recipient <https://example.org/andric-letters/entity/per_zdenka_markovic> ;
    schema:sender <https://example.org/andric-letters/entity/per_ivo_andric> ;
    schema:text """Вишеград, 13. VII 1926.
Draga gospođice,
hvala puno na sjećanju iz Maribora. Nadam se da
ste dobro i Vi i gđa mama. Ja sam malko slab i oporavljam se. Srdačno pozdravlja
Ivo Andrić
Višegrad 13. VII. 26.
[Адреса:]
Dr. Zdenka Marković
schriftsteller
Bad Villach
bei Eisen Kappel
Karnten Austrija"""@sr-Latn .

<https://example.org/andric-letters/letter/letter_0007> a andric:Letter,
        schema:Message ;
    dcterms:identifier "letter_0007" ;
    dcterms:isPartOf andric:andric-private-letters-1925-1941 ;
    prov:hadPrimarySource "0003_p003.xml" ;
    andric:hasMention <https://example.org/andric-letters/mention/letter_0007/43>,
        <https://example.org/andric-letters/mention/letter_0007/44>,
        <https://example.org/andric-letters/mention/letter_0007/45>,
        <https://example.org/andric-letters/mention/letter_0007/46> ;
    schema:dateSent "1926-10-20"^^xsd:date ;
    schema:locationCreated <https://example.org/andric-letters/entity/loc_beograd> ;
    schema:mentions <https://example.org/andric-letters/entity/date_20_x_1926>,
        <https://example.org/andric-letters/entity/date_20_x_26>,
        <https://example.org/andric-letters/entity/loc_beograd>,
        <https://example.org/andric-letters/entity/per_ivo_andric> ;
    schema:pagination "3" ;
    schema:recipient <https://example.org/andric-letters/entity/per_zdenka_markovic> ;
    schema:sender <https://example.org/andric-letters/entity/per_ivo_andric> ;
    schema:text """Београд, 20. X 1926.
Beograd 20. X. 26.
Draga gospođice,
hvala Vam na pismu koje me je obradovalo, iako
san o kom mi pišete nije mnogo veseo. Ali, Bog će dati
pa će dobro biti. Ovih dana sam mnogo mislio o pok.
mami, jer joj upravo sada podižemo spomenik. Moja
tetka je zdravo i, koliko se može, dobro. Znam i vjerujem Vam da se ne osećate dobro u tom zagrebačkom
„javnom“ životu. Svuda je zlo. Ali podnosilo se i gore,
pa valja snositi. Pozdravite sve Vaše. Javite se.
Srdačno Vas pozdravlja
Ivo Andrić"""@sr-Latn .

<https://example.org/andric-letters/letter/letter_0008> a andric:Letter,
        schema:Message ;
    dcterms:identifier "letter_0008" ;
    dcterms:isPartOf andric:andric-private-letters-1925-1941 ;
    prov:hadPrimarySource "0003_p003.xml" ;
    andric:hasMention <https://example.org/andric-letters/mention/letter_0008/47>,
        <https://example.org/andric-letters/mention/letter_0008/48>,
        <https://example.org/andric-letters/mention/letter_0008/49>,
        <https://example.org/andric-letters/mention/letter_0008/50>,
        <https://example.org/andric-letters/mention/letter_0008/51>,
        <https://example.org/andric-letters/mention/letter_0008/52> ;
    schema:dateSent "1927-02-02"^^xsd:date ;
    schema:locationCreated <https://example.org/andric-letters/entity/loc_marseille> ;
    schema:mentions <https://example.org/andric-letters/entity/date_2_februara_1927>,
        <https://example.org/andric-letters/entity/date_2_ii_1927>,
        <https://example.org/andric-letters/entity/loc_marseille>,
        <https://example.org/andric-letters/entity/loc_st_jacques>,
        <https://example.org/andric-letters/entity/loc_visegrad>,
        <https://example.org/andric-letters/entity/per_ivo_andric> ;
    schema:pagination "3" ;
    schema:recipient <https://example.org/andric-letters/entity/per_zdenka_markovic> ;
    schema:sender <https://example.org/andric-letters/entity/per_ivo_andric> ;
    schema:text """Mарсеј, 2. II 1927.
Marseille 2 februara 1927
51, rue St. Jacques
Draga gospođice,
davno sam primio Vaše pismo, ali su me svakojake
nedaće zadržale sve do danas da Vam se javim. Prebolio
sam anginu a još vučem grip. Međutim pre deset dana
umrla mi je tetka u Višegradu. Na žalost nisam mogao
ni na sahranu da joj odem. To je bio poslednji član naše
porodice t. j. predposlednji, jer poslednji sam ja. U tri
poslednje godine ja sam, kao što znate izgubio tetka,
majku i tetku. t. j. sve što sam imao. Vi ćete razumjeti,
kad Vam kažem da mi nije lako.
Nadam se da ste Vi i Vaši dobro i zdravo. Javite
mi se.
Sredačno Vas pozdravlja Vaš
Ivo Andrić
Molim Vas pišite mi na kućnu adresu."""@sr-Latn .

<https://example.org/andric-letters/letter/letter_0009> a andric:Letter,
        schema:Message ;
    dcterms:identifier "letter_0009" ;
    dcterms:isPartOf andric:andric-private-letters-1925-1941 ;
    prov:hadPrimarySource "0003_p003.xml;0004_p004.xml" ;
    andric:hasMention <https://example.org/andric-letters/mention/letter_0009/53>,
        <https://example.org/andric-letters/mention/letter_0009/54>,
        <https://example.org/andric-letters/mention/letter_0009/55>,
        <https://example.org/andric-letters/mention/letter_0009/56>,
        <https://example.org/andric-letters/mention/letter_0009/57>,
        <https://example.org/andric-letters/mention/letter_0009/58>,
        <https://example.org/andric-letters/mention/letter_0009/59>,
        <https://example.org/andric-letters/mention/letter_0009/60>,
        <https://example.org/andric-letters/mention/letter_0009/61>,
        <https://example.org/andric-letters/mention/letter_0009/62>,
        <https://example.org/andric-letters/mention/letter_0009/63>,
        <https://example.org/andric-letters/mention/letter_0009/64>,
        <https://example.org/andric-letters/mention/letter_0009/65>,
        <https://example.org/andric-letters/mention/letter_0009/66>,
        <https://example.org/andric-letters/mention/letter_0009/67>,
        <https://example.org/andric-letters/mention/letter_0009/68> ;
    schema:dateSent "1927-04-20"^^xsd:date ;
    schema:locationCreated <https://example.org/andric-letters/entity/loc_marseille> ;
    schema:mentions <https://example.org/andric-letters/entity/date_20_aprila_1927>,
        <https://example.org/andric-letters/entity/date_20_iv_1927>,
        <https://example.org/andric-letters/entity/date_30_ix_1927>,
        <https://example.org/andric-letters/entity/loc_arles>,
        <https://example.org/andric-letters/entity/loc_avignon>,
        <https://example.org/andric-letters/entity/loc_marseille>,
        <https://example.org/andric-letters/entity/loc_nimes>,
        <https://example.org/andric-letters/entity/loc_provansa>,
        <https://example.org/andric-letters/entity/loc_st_jacques>,
        <https://example.org/andric-letters/entity/loc_zagreb>,
        <https://example.org/andric-letters/entity/org_vijenac>,
        <https://example.org/andric-letters/entity/per_ivo_andric>,
        <https://example.org/andric-letters/entity/per_nevistic>,
        <https://example.org/andric-letters/entity/per_tadeusz_boy-zelenski> ;
    schema:pagination "3;4" ;
    schema:recipient <https://example.org/andric-letters/entity/per_zdenka_markovic> ;
    schema:sender <https://example.org/andric-letters/entity/per_ivo_andric> ;
    schema:text """Mapcej, 20. IV 1927.
Marseille 20 aprila 1927.
51, rue St. Jacques
Draga gospođice,
hvala na pismu i dobrim željama i čestitkama koje
Vam uzvraćam od sveg srca. Istina je da nisam najbolje
sa zdravljem i da sam ovde pretrpan poslom koji je
težak i pun odgovornosti; sve drugo što pominjete brbljarije su i ogovaranja na koja čovjek mora u životu da
se navikne, naročito kad je t. zv. javni čovjek. Ne vredi
govoriti.
Tri dana uskrsa sam proveo u Provenci (Arles —
Nimes — Avignon). To me malo osvežilo i odmorilo
od ovog bučnog i nelijepog Marseilla. Teško je zamisliti
ljepotu n. pr. Avignona, a nikakva slika i nikakav opis
ne mogu je izraziti. Ja ljepšeg kraja nisam nikad vidio.
Nedavno je bio ovde poljski pisac Boy-Želenski i
držao konferenciju. Poljski konzul me upoznao s njim.
Interesantan čovjek.
Ne znam kad ću moći na odsustvo, ali ću Vam
svakako javiti i gledati da se zadržim dan u Zagrebu.
Molim Vas, kakav je časopis Vijenac? Urednik Dr.
Nevistić neprestano me moli za prilog, i ja sam ga
obećao. Može li se u njemu sarađivati?
Ja ovde ne pišem gotovo ništa, ali čitam. Dosta i
proučavam ovu zemlju koja je čudna i svima nama nedovoljno poznata.
Pozdravite srdačno sve Vaše i javite mi se opet.
Najljepše Vas pozdravlja
Ivo Andrić
Maрсеј, 30. IX 1927."""@sr-Latn .

