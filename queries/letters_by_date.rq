PREFIX ex: <https://example.org/andric-letters/>
PREFIX schema: <https://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?letter ?date ?placeLabel ?recipientLabel
WHERE {
  ?letter a ex:Letter .
  OPTIONAL { ?letter schema:dateSent ?date . }
  OPTIONAL { ?letter schema:locationCreated ?place . ?place rdfs:label ?placeLabel . }
  OPTIONAL { ?letter schema:recipient ?recipient . ?recipient rdfs:label ?recipientLabel . }
}
ORDER BY ?date
