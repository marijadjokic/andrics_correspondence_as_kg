PREFIX ex: <https://example.org/andric-letters/>
PREFIX schema: <https://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?letter ?entity ?label ?type
WHERE {
  ?letter a ex:Letter ;
          schema:mentions ?entity .
  ?entity rdfs:label ?label ;
          <http://purl.org/dc/terms/type> ?type .
}
ORDER BY ?letter ?type ?label
